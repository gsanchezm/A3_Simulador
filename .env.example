DATABASE_URL=postgresql://usuario:clave@servidor/base?sslmode=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=elige-una-clave-larga-y-unica
REPORT_SIGNING_KEY=una-clave-aleatoria-de-al-menos-32-caracteres
PORT=3000

# Número de proxies de confianza delante de la app (vacío = ninguno). Si va detrás de un proxy que termina TLS,
# pon 1 (o los saltos que correspondan) para que la IP del cliente y el protocolo se calculen bien.
TRUST_PROXY=
